{
  "name": "zombie",
  "functions": [
    "H(t)", "Z(t)"
  ],
  "parameters": [],
  "equations": {
    "diff[H, t]": "0.365 * H - 0.95 * H * Z",
    "diff[Z, t]": "0.84 * H * Z - 0.44 * H * Z - 0.09 * Z"
  },
  "conditions": {
    "H(t: 0)": 0.6,
    "Z(t: 0)": 0.6
  },
  "outputs": ["H(t)", "Z(t)"],
  "displays": [
    "plot(x: t * 0.02 - 1.0, y: H)",
    "plot(x: t * 0.02 - 1.0, y: Z)"
  ]
}
